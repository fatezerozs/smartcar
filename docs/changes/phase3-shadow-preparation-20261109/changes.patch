+    if(!(x>=0&&x<=32.767f))return 0;
+    return (int16_t)(x*1000.0f);
+}
+static void record(uint32_t now,const vdr_info_t *s,uint32_t elapsed)
+{
+    shadow_row_t *r=&rows[head];memset(r,0,sizeof(*r));

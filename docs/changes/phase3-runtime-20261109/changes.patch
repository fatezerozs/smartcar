+        else if(planner.supervisor.mode==SP_STOP_LATCHED&&info.mode==VDR_CONTROL)vision_drive_stop();
+    } else if(have_result){
+        if(result.supervisor_mode==planner.supervisor.mode&&result.supervisor_generation==planner.supervisor.generation)

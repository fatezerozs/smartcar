+++ b/tools/speed_planning/shadow_visual_runner.c
@@ -0,0 +1,56 @@
+/* Hybrid fixture: measured visual flags/times; all geometry and motion are
+ * explicitly synthetic. Executes target shadow code, never PI or hardware. */
+#ifdef _MSC_VER
+#define _CRT_SECURE_NO_WARNINGS
+#endif
+#include "vision_planner_shadow.h"
+#include "visual_policy.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+int main(int argc,char **argv)
+{
+    FILE *input,*output;char line[512];unsigned index,seq,cap,now,near_ok,far_ok;
+    unsigned arm_index;vps_state_t state;vps_config_t config;vps_input_t in;vps_result_t result;
+    if(argc!=6)return 2;arm_index=(unsigned)strtoul(argv[3],NULL,10);
+    memset(&config,0,sizeof(config));config.policy=(sp_policy_t)VISUAL_POLICY;
+    config.policy.far_budget_ms=(uint32_t)strtoul(argv[4],NULL,10);
+    config.policy.far_frames=(unsigned)strtoul(argv[5],NULL,10);
+    config.planner.revision=1;
+    config.planner.limits=(sp_limits_t){SP_SIMULATION,3,1,2,1,2,4,6,.02f,.02f,.0001f,.05f};
+    config.planner.ticks_per_metre_left=11000;config.planner.ticks_per_metre_right=12000;
+    config.planner.max_left_ticks_10ms=config.planner.max_right_ticks_10ms=1000;
+    config.planner.frame_max_age_ms=100;config.planner.encoder_max_age_ms=30;config.planner.candidate_max_age_ms=20;
+    if(!vps_init(&state,VP_SHADOW,&config))return 3;
+    input=fopen(argv[1],"r");if(!input)return 3;output=fopen(argv[2],"w");if(!output){fclose(input);return 3;}
+    fprintf(output,"index,mode,authorized,inhibit,farActive,farStreak,farStartedMs,stopActive,faults,generation,armAttempt,armAccepted,status,action,leftTicks10ms,rightTicks10ms,matches\n");
+    if(!fgets(line,sizeof(line),input))return 4;
+    while(fgets(line,sizeof(line),input)){
+        int attempt,accepted=0;
+        if(sscanf(line,"%u,%u,%u,%u,%u,%u",&index,&seq,&cap,&now,&near_ok,&far_ok)!=6)return 4;
+        memset(&in,0,sizeof(in));memset(&result,0,sizeof(result));
+        in.identity=(vp_stamp_t){9,1,1,seq,index+1,cap,now,0};in.external_admitted=1;in.valid=VP_VALID_ALL;
+        in.observation.now_ms=now;in.observation.capture_ms=cap;in.observation.frame_seq=seq;
+        in.observation.near_valid=(uint8_t)near_ok;in.observation.far_valid=(uint8_t)far_ok;
+        in.observation.new_frame=in.observation.encoder_valid=in.observation.capture_odometer_valid=1;
+        in.observation.encoder_seq=index+1;in.observation.encoder_ms=now;
+        /* Not image-derived or calibrated: straight 2.25m/3.75m fixtures,
+         * zero measured/reference speed and zero distance for this replay. */
+        in.near_preview.units=in.full_preview.units=SP_METRES;
+        in.near_preview.count=in.full_preview.count=SP_CAPACITY;
+        in.near_preview.sequence=in.full_preview.sequence=seq;
+        in.near_preview.capture_ms=in.full_preview.capture_ms=cap;
+        for(unsigned j=0;j<SP_CAPACITY;++j){in.near_preview.distance[j]=(float)j*.15f;in.full_preview.distance[j]=(float)j*.25f;}
+        attempt=index==arm_index;
+        if(attempt)accepted=vps_arm(&state,&in);else (void)vps_tick(&state,&in,&result);
+        fprintf(output,"%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%d,%d,%u,%u,%u,%u,%d\n",index,
+            (unsigned)state.supervisor.mode,(unsigned)state.supervisor.authorized,(unsigned)state.supervisor.motor_inhibit,
+            (unsigned)state.supervisor.far_active,state.supervisor.far_streak,(unsigned)state.supervisor.far_started_ms,
+            (unsigned)state.supervisor.stop_active,(unsigned)state.supervisor.faults,(unsigned)state.supervisor.generation,
+            attempt,accepted,(unsigned)result.status,(unsigned)result.candidate.action,
+            (unsigned)result.candidate.left_ticks_10ms,(unsigned)result.candidate.right_ticks_10ms,
+            vps_result_matches(&state,&result,&in.identity,now));
+    }
+    if(ferror(input)||ferror(output)){fclose(input);fclose(output);return 5;}
+    fclose(input);return fclose(output)?5:0;
+}
diff --git a/tools/speed_planning/replay_shadow_visual.py b/tools/speed_planning/replay_shadow_visual.py
--- /dev/null
+++ b/tools/speed_planning/replay_shadow_visual.py
@@ -0,0 +1,98 @@
+"""Offline target-shadow replay over verified visual metadata; synthetic motion/geometry."""
+import argparse
+import csv
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+from tools.speed_planning.analyze_visual_trace import analyze
+from tools.speed_planning.replay_visual_supervisor import run as run_supervisor
+from tools.speed_planning.replay import compile_command
+from tools.speed_planning.vehicle_model import ROOT
+
+
+def run(session, output, compiler=None):
+    session, output = Path(session).resolve(), Path(output).resolve()
+    analyze(session)  # CRC/SHA/complete-session checks before creating artifacts.
+    if output.exists():
+        raise ValueError('Output must be a new directory')
+    family = os.environ.get('SMARTCAR_TEST_COMPILER', 'gcc')
+    mode = os.environ.get('SMARTCAR_TEST_MODE', 'optimized')
+    if family not in ('gcc', 'msvc') or mode not in ('optimized', 'asan'):
+        raise ValueError('Unsupported compiler family/mode')
+    compiler = compiler or os.environ.get('SMARTCAR_TEST_COMPILER_PATH') or shutil.which('cl' if family == 'msvc' else 'gcc')
+    if not compiler:
+        raise ValueError('Existing compiler required')
+    output.mkdir(parents=True)
+    # Reuses source verification + independent Python oracle, not a second
+    # implementation of production supervisor rules or image recognition.
+    baseline = output/'supervisor'
+    reference = run_supervisor(session, baseline, compiler)
+    sources = [ROOT/'tools/speed_planning/shadow_visual_runner.c', ROOT/'demo/code/vision_planner_shadow.c',
+               ROOT/'demo/code/vision_planner.c', ROOT/'tools/speed_planning/speed_planner.c']
+    exe = output/'shadow-visual.exe'
+    command = compile_command(str(compiler), family, mode, sources, [ROOT/'demo/code', baseline], exe)
+    subprocess.run(command, cwd=output, check=True, capture_output=True, timeout=60)
+    reports = []
+    columns = ['index', 'mode', 'authorized', 'inhibit', 'farActive', 'farStreak', 'farStartedMs',
+               'stopActive', 'faults', 'generation', 'armAttempt', 'armAccepted']
+    for case in reference['experiments']:
+        path = output/(case['case']+'.csv')
+        subprocess.run([exe, baseline/'observations.csv', path, str(case['explicitArmIndex']),
+                        str(case['farBudgetMs']), str(case['farRecoveryFrames'])], cwd=output, check=True, timeout=15)
+        with path.open(newline='', encoding='utf-8') as file:
+            actual = list(csv.DictReader(file))
+        with (baseline/path.name).open(newline='', encoding='utf-8') as file:
+            expected = list(csv.DictReader(file))
+        if len(actual) != 750 or len(actual) != len(expected):
+            raise AssertionError('Incomplete target shadow replay')
+        ready, controlled, inhibited = 0, 0, 0
+        for got, want in zip(actual, expected):
+            if any(got[k] != want[k] for k in columns):
+                raise AssertionError(f"{case['case']} row {got['index']}: supervisor mismatch")
+            if int(got['leftTicks10ms']) or int(got['rightTicks10ms']):
+                raise AssertionError('Synthetic zero-speed fixture produced nonzero integer targets')
+            if got['status'] == '2':  # VPS_READY
+                ready += 1
+                if got['matches'] != '1':
+                    raise AssertionError('Fresh shadow candidate failed publication check')
+                if got['mode'] == '4':
+                    controlled += 1
+                    if got['action'] != '2':
+                        raise AssertionError('Controlled stop did not shape zero target')
+            if got['inhibit'] == '1':
+                inhibited += 1
+                if got['matches'] != '0' or got['action'] != '0':
+                    raise AssertionError('Inhibited state retained a consumable candidate')
+        reports.append({'case': case['case'], 'rows': len(actual), 'supervisorMatchesIndependentOracle': True,
+                        'readyCandidates': ready, 'controlledStopCandidates': controlled, 'inhibitedRows': inhibited,
+                        'csvSha256': hashlib.sha256(path.read_bytes()).hexdigest()})
+    result = {'schemaVersion': 'smartcar.shadow-visual-replay/1', 'sourceFrames': 750,
+              'sourceSessionSha256': reference['sourceSessionSha256'], 'hardwareAccessed': False,
+              'productionApproved': False, 'runtimeConnected': False,
+              'evidence': 'measured-visual-metadata-with-synthetic-metric-and-zero-motion-inputs',
+              'syntheticInputs': {'measuredSpeedMps': 0, 'referenceSpeedMps': 0, 'odometerM': 0,
+                                  'leftTicksPerM': 11000, 'rightTicksPerM': 12000,
+                                  'geometry': 'straight near2.25m/full3.75m, not image-derived'},
+              'experiments': reports, 'compilerFamily': family, 'compilerMode': mode, 'compileCommand': command,
+              'sourcesSha256': {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
+                               for p in sources + [Path(__file__), ROOT/'demo/code/vision_planner_shadow.h',
+                                                  ROOT/'demo/code/vision_planner.h', ROOT/'tools/speed_planning/speed_planner.h']},
+              'limits': ['No image algorithm or measured metric preview.', 'Motion, scales and zero-speed confirmations are synthetic.',
+                         'No live scheduler, PI, PWM, C26 admission or production threshold approval.']}
+    (output/'report.json').write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')
+    print(json.dumps({'frames': 750, 'cases': len(reports), 'rows': sum(c['rows'] for c in reports),
+                      'productionApproved': False}))
+    return result
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('session', type=Path)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--compiler')
+    args = parser.parse_args()
+    run(args.session, args.output, args.compiler)
diff --git a/tests/planning/test_planner_shadow.c b/tests/planning/test_planner_shadow.c
--- /dev/null
+++ b/tests/planning/test_planner_shadow.c
@@ -0,0 +1,171 @@
+#include "vision_planner_shadow.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static unsigned checks;
+#define CHECK(x) do{++checks;if(!(x)){fprintf(stderr,"shadow:%d %s\n",__LINE__,#x);exit(1);}}while(0)
+static vps_config_t config(void)
+{
+    vps_config_t c;memset(&c,0,sizeof(c));c.planner.revision=1;
+    c.planner.limits=(sp_limits_t){SP_SIMULATION,3,1,2,1,2,4,6,.02f,.02f,.0001f,.05f};
+    c.planner.ticks_per_metre_left=11000;c.planner.ticks_per_metre_right=12000;
+    c.planner.max_left_ticks_10ms=c.planner.max_right_ticks_10ms=1000;
+    c.planner.frame_max_age_ms=100;c.planner.encoder_max_age_ms=30;c.planner.candidate_max_age_ms=20;
+    c.policy=(sp_policy_t){100,30,300,60,1000,3,3,3,1,.01f};return c;
+}
+static void sync(vps_input_t *in)
+{
+    sp_input_t *i=&in->observation;
+    in->identity.frame_seq=i->frame_seq;in->identity.capture_ms=i->capture_ms;
+    in->identity.encoder_seq=i->encoder_seq;in->identity.encoder_ms=i->encoder_ms;
+    in->near_preview.sequence=in->full_preview.sequence=i->frame_seq;
+    in->near_preview.capture_ms=in->full_preview.capture_ms=i->capture_ms;
+}
+static vps_input_t input(void)
+{
+    vps_input_t in;memset(&in,0,sizeof(in));in.valid=VP_VALID_ALL;in.external_admitted=1;
+    in.identity.output_epoch=9;in.identity.config_revision=1;
+    in.requested_speed_m_s=1;
+    in.observation.new_frame=in.observation.near_valid=in.observation.far_valid=1;
+    in.observation.encoder_valid=in.observation.capture_odometer_valid=1;
+    in.observation.measured_speed=.5f;in.observation.now_ms=100;
+    in.observation.capture_ms=in.observation.encoder_ms=100;
+    in.near_preview.units=in.full_preview.units=SP_METRES;
+    in.near_preview.count=in.full_preview.count=SP_CAPACITY;
+    for(unsigned j=0;j<SP_CAPACITY;++j){in.near_preview.distance[j]=(float)j*.15f;in.full_preview.distance[j]=(float)j*.25f;}
+    sync(&in);return in;
+}
+static void step(vps_input_t *in,int near_ok,int far_ok)
+{
+    sp_input_t *i=&in->observation;i->now_ms+=10;i->capture_ms=i->encoder_ms=i->now_ms;
+    ++i->frame_seq;++i->encoder_seq;i->new_frame=1;i->near_valid=(uint8_t)near_ok;i->far_valid=(uint8_t)far_ok;
+    i->odometer_m+=.005f;i->odometer_at_capture_m=i->odometer_m;sync(in);
+}
+static void arm(vps_state_t *s,vps_input_t *in,vps_config_t c)
+{*in=input();CHECK(vps_init(s,VP_SHADOW,&c));CHECK(vps_arm(s,in));}
+static void zero(vps_result_t r)
+{CHECK(!r.candidate.left_ticks_s&&!r.candidate.right_ticks_s&&!r.candidate.left_ticks_10ms&&!r.candidate.right_ticks_10ms);}
+static void admission(void)
+{
+    vps_state_t s;vps_config_t c=config();vps_input_t in=input();vps_result_t r;
+    CHECK(!vps_init(&s,VP_DISABLED,&c));CHECK(vps_tick(&s,&in,&r)==VPS_INACTIVE);zero(r);
+    c.policy.far_frames=0;CHECK(!vps_init(&s,VP_SHADOW,&c));c=config();
+    CHECK(vps_init(&s,VP_SHADOW,&c));in.external_admitted=0;CHECK(!vps_arm(&s,&in));
+    in.external_admitted=1;in.observation.far_valid=0;CHECK(!vps_arm(&s,&in));
+    step(&in,1,1);CHECK(vps_tick(&s,&in,&r)==VPS_ZERO);CHECK(s.supervisor.mode==SP_DISARMED);zero(r);
+    CHECK(vps_arm(&s,&in));CHECK(!vps_arm(&s,&in));
+    step(&in,1,1);CHECK(vps_tick(&s,&in,&r)==VPS_READY);
+    CHECK(vps_result_matches(&s,&r,&in.identity,in.observation.now_ms));
+    in.external_admitted=0;step(&in,1,1);CHECK(vps_tick(&s,&in,&r)==VPS_ZERO);
+    CHECK(s.supervisor.mode==SP_STOP_LATCHED);in.external_admitted=1;CHECK(!vps_arm(&s,&in));
+    step(&in,1,1);CHECK(vps_tick(&s,&in,&r)==VPS_ZERO);zero(r);
+    arm(&s,&in,c);in.identity.output_epoch++;step(&in,1,1);
+    CHECK(vps_tick(&s,&in,&r)==VPS_ZERO&&s.supervisor.mode==SP_STOP_LATCHED);
+    arm(&s,&in,c);step(&in,1,1);in.identity.config_revision++;
+    CHECK(vps_tick(&s,&in,&r)==VPS_FAULT);CHECK(!vps_arm(&s,&in));zero(r);
+    arm(&s,&in,c);CHECK(vps_tick(&s,NULL,&r)==VPS_FAULT);zero(r);
+    CHECK(vps_tick(NULL,NULL,&r)==VPS_INACTIVE);CHECK(vps_tick(NULL,NULL,NULL)==VPS_FAULT);
+}
+static void state_and_samples(void)
+{
+    vps_state_t s;vps_input_t in;vps_result_t r,previous;vps_config_t c=config();arm(&s,&in,c);
+    step(&in,1,1);CHECK(vps_tick(&s,&in,&r)==VPS_READY);previous=r;
+    CHECK(s.trajectory.speed>.5f&&s.control_revision==r.candidate.stamp.control_revision);
+    CHECK(vps_tick(&s,&in,&r)==VPS_WAIT);zero(r);
+    CHECK(!vps_result_matches(&s,&previous,&in.identity,in.observation.now_ms));
+    float held=s.trajectory.speed;step(&in,1,1);in.observation.new_frame=0;
+    in.observation.frame_seq=s.supervisor.last_frame_seq;in.observation.capture_ms=s.supervisor.last_capture_ms;sync(&in);
+    CHECK(vps_tick(&s,&in,&r)==VPS_READY&&s.trajectory.speed>held);

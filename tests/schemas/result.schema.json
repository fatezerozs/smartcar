                "type": "number",
                "minimum": 0
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "startedAt": {
                "type": "string",
                "minLength": 1
              },
              "finishedAt": {
                "type": "string",
                "minLength": 1
              },
              "processes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "logDirectory": {
                "type": "string",
                "minLength": 1
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "schemaVersion",
              "id",
              "status",
              "evidenceClass",
              "layer",
              "category",
              "required",
              "reason",
              "durationSeconds",
              "exitCode",
              "startedAt",
              "finishedAt",
              "processes",
              "variants",
              "logDirectory",
              "dependsOn",
              "artifacts",
              "details"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "profile",
        "startedAt",
        "finishedAt",
        "durationSeconds",
        "git",
        "manifestSha256",
        "environment",
        "status",
        "softwarePassed",
        "releaseEligible",
        "scope",
        "risks",
        "suites"
      ],
      "additionalProperties": false
    }
  ]
}

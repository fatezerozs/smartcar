                "type": "string",
                "minLength": 1
              },
              "layer": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },

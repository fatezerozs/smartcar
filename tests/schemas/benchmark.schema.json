{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "enum": [
        "pending",
        "ready"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidenceClass": {
      "enum": [
        "pq_host",
        "pq_target",
        "pq_system"
      ]
    },
    "dataset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "groundTruthSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "groundTruthPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "sha256",
        "groundTruthSha256",
        "groundTruthPath",
        "path"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object"
    },
    "warmup": {
      "type": "integer",
      "minimum": 0
    },
    "repetitions": {
      "type": "integer",
      "minimum": 2
    },
    "adapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvedBaseline": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "dimension": {
            "enum": [
              "quality",
              "computation",
              "system"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "lower",
              "higher"
            ]
          },
          "statistic": {
            "enum": [
              "mean",
              "median",
              "p95",
              "p99",
              "max",
              "min"
            ]
          },
          "validSampleRule": {
            "type": "string",
            "minLength": 1
          },
          "thresholdSource": {
            "type": "string",
            "minLength": 1
          },
          "safetyCritical": {
            "type": "boolean"
          },
          "gate": {
            "enum": [
              "observation",
              "absolute",
              "regression",
              "no-regression"
            ]
          },
          "absoluteLimit": {
            "type": "number"
          },
          "maxRegressionFraction": {
            "type": "number",
            "minimum": 0
          },
          "noiseFraction": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "dimension",
          "unit",
          "direction",
          "statistic",
          "validSampleRule",
          "thresholdSource",
          "safetyCritical",
          "gate",
          "noiseFraction"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "status",
    "reason",
    "evidenceClass",
    "dataset",
    "parameters",
    "warmup",
    "repetitions",
    "adapter",
    "approvedBaseline",
    "metrics"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "dataset": {
            "properties": {
              "sha256": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

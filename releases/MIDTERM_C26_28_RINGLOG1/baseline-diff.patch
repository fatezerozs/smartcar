+/* Both planners publish CURRENT white-checked guides. The connected planner
+ * may additionally guide the near band; the legacy guide owns preview only. */
+static int ring_entry_preview(const vision_result_t *r,const vc_config_t *c,float *error,float *center)
+{
+    vc_config_t one=*c;float sum=0,cx=0;int count=0;
+    int limit=(int)(c->near_y*(VISION_HEIGHT-1))-4;
+    if(r->roundabout_state!=1||r->entry_guide_rows<12)return 0;
+    one.band_half_height=.001f;one.min_band_rows=1;
+    for(int row=VISION_ROI_TOP;row<=limit;++row){
+        float e,x,half_width=(r->row_flags[row]==3||r->row_flags[row]==4)?
+            (r->right[row]-r->left[row]+1)*.5f:r->row_width[row]*.5f;
+        if(r->entry_guide[row]>=VISION_WIDTH||half_width<VISION_MIN_WIDTH*.5f||
+           !band_error(r,&one,(float)row/(VISION_HEIGHT-1),&e,&x))continue;
+        e+=((float)r->entry_guide[row]-x*(VISION_WIDTH-1))/half_width;
+        sum+=e;cx+=(float)r->entry_guide[row]/(VISION_WIDTH-1);++count;
+    }
+    if(count<6)return 0;
+    *error=sum/count;*center=cx/count;return finite_value(*error);
 }
 
